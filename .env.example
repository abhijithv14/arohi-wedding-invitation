# Public site URL
NEXT_PUBLIC_SITE_URL=https://arohi-wedding.vercel.app

# Google Sheets RSVP integration (SERVER-SIDE ONLY)
# Spreadsheet ID from the Google Sheets URL
GOOGLE_SHEET_ID=1ixXbLqQseubTt8HxyU7hZr2ubXHqJeW-SD-qeDx2tts
# Google service account email with Editor access to the spreadsheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Service account private key. In Vercel, paste the full key and keep the \n characters intact.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# RSVP columns: Name | Phone Number | Guest Count | Submitted At
GOOGLE_SHEET_RANGE=A:D
